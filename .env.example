# Slack (see manifest.yml) — xoxb- bot token and xapp- app-level token (connections:write)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# LLM provider — any OpenAI-compatible endpoint
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# SYSTEM_PROMPT=You are a helpful assistant in Slack.
# MAX_CONTEXT_TOKENS=8000
# LOG_LEVEL=INFO

# --- overseer control (optional) ---
# Slack user ids allowed to operate the gold-finger overseer, comma-separated.
# Empty (the default) admits nobody, so the overseer tools stay hidden.
OVERSEER_ADMIN_IDS=
# Where the gold-finger repo and its python live, if not the defaults.
# GOLDFINGER_REPO=~/dev/private/gold-finger
# OVERSEER_PYTHON=~/anaconda3/envs/gold-finger/bin/python
# OVERSEER_LABEL=com.goldfinger.overseer
